# Copy to .env and fill in. Never commit .env.

# LLM providers - set at least one. In "Auto" mode Groq is tried first, then Gemini.
GROQ_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Protects the endpoints that create, edit or delete collections (and the
# query-suggestion endpoint). Leave empty for local single-user use; set it
# for any deployment other people can reach.
API_KEY=

# PDF parser. docker compose sets this to http://grobid:8070 for you.
# GROBID_URL=http://localhost:8070

# Requests per minute per client IP; 0 disables the limit.
# RATE_LIMIT_PER_MINUTE=20
# ADMIN_RATE_LIMIT_PER_MINUTE=30

# LLM_TIMEOUT_SECONDS=90

# Comma-separated origins allowed to call the API from other web pages.
# CORS_ORIGINS=https://example.com
